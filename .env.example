# Copy to .env and fill with values from your Supabase project settings > API.
# The anon key is public by design; row-level security is the security boundary.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional — only used by `npm run gen:ai-art` (dev tooling; never bundled into
# the client). Free key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
